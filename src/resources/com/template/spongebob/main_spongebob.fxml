<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="840.0" prefWidth="1060.0" styleClass="spongebob-root"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.template.controller.MainController">
    <children>
        <!-- LAYOUT BASE DO APLICATIVO / TYCOON -->
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- HEADER ANOS 2000 COM LOGO, CLOCK DE JOGO, CONCHAS E ATALHOS -->
            <top>
                <VBox spacing="0.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="spongebob-header-box">
                        <padding>
                            <Insets bottom="6.0" left="10.0" right="10.0" top="6.0" />
                        </padding>
                        <children>
                            <ImageView fitHeight="65.0" preserveRatio="true" smooth="true">
                                <image>
                                    <Image url="@images/logo_nome_bob_esponja.png" />
                                </image>
                            </ImageView>
                            <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <children>
                                            <Label styleClass="spongebob-title" text="SIRI CASCUDO 2000" />
                                            <!-- GAME CLOCK & SALDO DE CONCHAS -->
                                            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="hud-pill">
                                                <children>
                                                    <Label fx:id="lblClock" styleClass="hud-clock" text="⏰ 11:30 AM" />
                                                    <Label text="|" style="-fx-text-fill: #ffa000;" />
                                                    <Label fx:id="lblCoins" styleClass="hud-coins" text="🐚 50 Conchas" />
                                                    <Label text="|" style="-fx-text-fill: #ffa000;" />
                                                    <Label fx:id="lblCps" styleClass="hud-cps" text="+0/s" />
                                                </children>
                                            </HBox>
                                        </children>
                                    </HBox>

                                    <!-- BARRA DE AÇÕES ATIVAS (SEM FICAR PARADO) -->
                                    <HBox spacing="6.0" style="-fx-padding: 3 0 0 0;" alignment="CENTER_LEFT">
                                        <children>
                                            <Button text="🔥 Chapa do Siri (Fritar!)" onAction="#onGrillBurger"
                                                    styleClass="retro-btn-grill" />
                                            <Button text="💻 Desafios Dev SQL" onAction="#onOpenCodeChallenges"
                                                    styleClass="retro-btn-header-action" />
                                            <Button text="⚡ Skills PostgreSQL" onAction="#onOpenSkills"
                                                    styleClass="retro-btn-header-action" />
                                            <Button text="🐟 Atender Clientes" onAction="#onOpenAssistantTerminal"
                                                    styleClass="retro-btn-header-action" />
                                            <Button text="🔐 Cofre" onAction="#onOpenSecretSafe"
                                                    styleClass="retro-btn-header-easter" />
                                            <Button text="🫧 Bolhas (B)" onAction="#onBlowBubbles"
                                                    styleClass="retro-btn-header-easter" />
                                            <Button text="💥 Resetar Jogo" onAction="#onResetGame"
                                                    styleClass="retro-btn-header-reset" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <!-- ESPAÇO RESERVADO PARA O BOB ESPONJA QUE FLUTUA NO OVERLAY -->
                            <VBox alignment="CENTER" prefWidth="120.0">
                                <Label styleClass="bubble-subtext" text="(Arraste o Bob 🍍)" />
                                <Label styleClass="bubble-subtext" text="(Leve até o Gary!)" />
                            </VBox>
                        </children>
                    </HBox>
                </VBox>
            </top>

            <!-- CONTEUDO CENTRAL -->
            <center>
                <HBox spacing="10.0">
                    <padding>
                        <Insets bottom="6.0" left="10.0" right="10.0" top="6.0" />
                    </padding>
                    <children>
                        <!-- PAINEL ESQUERDO: LULA MOLUSCO NO CAIXA -->
                        <VBox alignment="TOP_CENTER" spacing="6.0" prefWidth="145.0" styleClass="character-panel">
                            <padding>
                                <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                            </padding>
                            <children>
                                <Label styleClass="retro-badge-label" text="[ CAIXA DO SIRI ]" />
                                <ImageView fx:id="imgSquidward" fitHeight="185.0" preserveRatio="true" smooth="true" styleClass="interactive-char">
                                    <image>
                                        <Image url="@images/lula_molusco.png" />
                                    </image>
                                </ImageView>
                                <Label fx:id="lblSquidwardQuote" styleClass="speech-bubble" wrapText="true"
                                       text="&quot;Faça seu pedido logo e não fale comigo. (Clique 2x em mim)&quot;" />
                            </children>
                        </VBox>

                        <!-- PAINEL PRINCIPAL DO CRUD -->
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <!-- FORMULÁRIO RETRO COM NOVAS COLUNAS DA FENDA -->
                                <VBox styleClass="retro-window-panel" spacing="6.0">
                                    <padding>
                                        <Insets bottom="8.0" left="12.0" right="12.0" top="6.0" />
                                    </padding>
                                    <children>
                                        <HBox styleClass="panel-title-bar">
                                            <Label styleClass="panel-title-text" text="📋 REGISTRO DE MERCADORIAS DA FENDA DO BIQUÍNI" />
                                        </HBox>

                                        <GridPane hgap="10.0" vgap="6.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="95.0" />
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" prefWidth="240.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="95.0" />
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" prefWidth="240.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="28.0" prefHeight="28.0" />
                                                <RowConstraints minHeight="28.0" prefHeight="28.0" />
                                                <RowConstraints minHeight="28.0" prefHeight="28.0" />
                                            </rowConstraints>
                                            <children>
                                                <Label styleClass="field-label" text="Código / ID:" />
                                                <TextField fx:id="txtId" editable="false" promptText="[Automático]"
                                                           styleClass="retro-input, retro-input-readonly"
                                                           GridPane.columnIndex="1" />

                                                <Label styleClass="field-label" text="Categoria / Setor:" GridPane.columnIndex="2" />
                                                <ComboBox fx:id="cbCategory" prefWidth="240.0" styleClass="retro-combo"
                                                          GridPane.columnIndex="3" />

                                                <Label styleClass="field-label" text="Nome do Item:" GridPane.rowIndex="1" />
                                                <TextField fx:id="txtName" promptText="Ex: Hambúrguer de Siri Deluxe"
                                                           styleClass="retro-input"
                                                           GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                <Label styleClass="field-label" text="Raridade Marinha:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                                <ComboBox fx:id="cbRarity" prefWidth="240.0" styleClass="retro-combo"
                                                          GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                                <Label styleClass="field-label" text="Descrição:" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtDescription" promptText="Ex: Com receita ultrassecreta do Seu Siriguejo"
                                                           styleClass="retro-input"
                                                           GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                                <Label styleClass="field-label" text="Preço em R$:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtPrice" promptText="Ex: 1.25"
                                                           styleClass="retro-input"
                                                           GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>

                                <!-- BOTOES E BARRA DE PESQUISA -->
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Button fx:id="btnSave" id="btnSave" text="Salvar 🍔"
                                                prefWidth="120.0" onAction="#onSave" mnemonicParsing="false"
                                                styleClass="retro-btn, retro-btn-save" />
                                        <Button fx:id="btnDelete" id="btnDelete" text="Excluir 💣"
                                                prefWidth="120.0" onAction="#onDelete" mnemonicParsing="false"
                                                styleClass="retro-btn, retro-btn-delete" />
                                        <Button fx:id="btnClear" id="btnClear" text="Limpar 🧼"
                                                prefWidth="110.0" onAction="#onClear" mnemonicParsing="false"
                                                styleClass="retro-btn, retro-btn-clear" />
                                        <TextField fx:id="txtSearch" prefWidth="220.0" promptText="🔍 Buscar na Fenda..."
                                                   styleClass="retro-input, retro-search"
                                                   HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <!-- TABELA RETRO EXPANDIDA -->
                                <TableView fx:id="tableItems" prefHeight="210.0" VBox.vgrow="ALWAYS" styleClass="retro-table">
                                    <columns>
                                        <TableColumn fx:id="colId" text="ID" maxWidth="60.0" minWidth="45.0" prefWidth="50.0" />
                                        <TableColumn fx:id="colName" text="Item / Produto" minWidth="130.0" prefWidth="180.0" />
                                        <TableColumn fx:id="colCategory" text="Setor / Origem" minWidth="110.0" prefWidth="140.0" />
                                        <TableColumn fx:id="colDescription" text="Detalhes Marinhos" minWidth="150.0" prefWidth="220.0" />
                                        <TableColumn fx:id="colRarity" text="Raridade" maxWidth="130.0" minWidth="90.0" prefWidth="110.0" />
                                        <TableColumn fx:id="colPrice" text="Preço (R$)" maxWidth="110.0" minWidth="80.0" prefWidth="95.0" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- PAINEL DIREITO: PATRÍCIA -->
                        <VBox alignment="TOP_CENTER" spacing="6.0" prefWidth="145.0" styleClass="character-panel">
                            <padding>
                                <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                            </padding>
                            <children>
                                <Label styleClass="retro-badge-label-patricia" text="[ CLIENTE VIP ]" />
                                <ImageView fx:id="imgPatricia" fitHeight="185.0" preserveRatio="true" smooth="true" styleClass="interactive-char">
                                    <image>
                                        <Image url="@images/patrick_femea_sem_fundo.png" />
                                    </image>
                                </ImageView>
                                <Label fx:id="lblPatriciaQuote" styleClass="speech-bubble-pink" wrapText="true"
                                       text="&quot;Olá rapazes! A Patrícia adora descontos! (Clique 2x em mim)&quot;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </center>

            <!-- MINI-GAME INTERATIVO DO GARY E DA AREIA DA FENDA -->
            <bottom>
                <VBox spacing="2.0">
                    <children>
                        <!-- ARENA DE JOGO DO GARY -->
                        <VBox styleClass="game-panel" spacing="4.0">
                            <padding>
                                <Insets bottom="4.0" left="10.0" right="10.0" top="4.0" />
                            </padding>
                            <children>
                                <!-- BARRA DE CONTROLE DO MINI-GAME -->
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label styleClass="game-title" text="🎮 MINI-GAME DA FENDA:" />
                                        <Button text="◀ Esquerda" onAction="#onGaryMoveLeft" styleClass="retro-btn-game" />
                                        <Button text="Direita ▶" onAction="#onGaryMoveRight" styleClass="retro-btn-game" />
                                        <Button text="Pular 🦘" onAction="#onGaryJump" styleClass="retro-btn-game" />
                                        <Button text="Alimentar Gary 🥫" onAction="#onGaryFeed" styleClass="retro-btn-game" />
                                        <Button text="Dança do Siri 💃" onAction="#onBobDance" styleClass="retro-btn-game" />
                                        <Label fx:id="lblGameStatus" styleClass="game-status-text"
                                               text="Arraste o Bob Esponja por cima de tudo para passear com o Gary na areia!"
                                               HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <!-- PISTA DE AREIA -->
                                <Pane fx:id="gameArea" prefHeight="75.0" styleClass="sand-track" />
                            </children>
                        </VBox>

                        <!-- STATUS BAR RETRO ANOS 2000 -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="retro-status-bar">
                            <padding>
                                <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                            </padding>
                            <children>
                                <Label styleClass="status-bar-text" text="🌊 Conexão: Servidor Siri Cascudo v2.0 (PostgreSQL)" />
                                <Label styleClass="status-bar-separator" text="|" />
                                <Label fx:id="lblDevRank" styleClass="status-bar-text" text="🎓 Cargo: Estagiário Lava-Pratos 🧼" />
                                <Label styleClass="status-bar-separator" text="|" />
                                <Label styleClass="status-bar-text" text="🍍 Bikini Bottom OS • GlassPane Ativo" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </bottom>

        </BorderPane>

        <!-- CAMADA GLOBAL OVERLAY (GLASSPANE): FICA POR CIMA DE ABSOLUTAMENTE TUDO -->
        <Pane fx:id="overlayPane" pickOnBounds="false"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- BOB ESPONJA ARRASTÁVEL LIVREMENTE POR CIMA DE TODA A TELA -->
                <ImageView fx:id="imgBob" fitHeight="85.0" layoutX="920.0" layoutY="12.0"
                           preserveRatio="true" smooth="true" styleClass="interactive-char">
                    <image>
                        <Image url="@images/bob_esponja_sem_fundo.png" />
                    </image>
                </ImageView>

                <!-- GARY O CARACOL NA PISTA DE AREIA DO OVERLAY -->
                <ImageView fx:id="imgGary" fitHeight="65.0" layoutX="40.0" layoutY="730.0"
                           preserveRatio="true" smooth="true" styleClass="interactive-char">
                    <image>
                        <Image url="@images/garry_normal.png" />
                    </image>
                </ImageView>
            </children>
        </Pane>

    </children>
</AnchorPane>
